{
  "name": "uatu",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "bin": {
    "uatu": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts serve",
    "bench:render": "bun run scripts/bench-render.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:licenses": "bun run src/shared/license-check.ts",
    "e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke-binary.ts",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:bundle": "redocly bundle api/openapi.yaml --output /tmp/uatu-openapi.yaml",
    "api:docs": "redocly build-docs api/openapi.yaml --output /tmp/uatu-api.html",
    "api:diff": "openapi-diff",
    "api:validate": "bun run scripts/validate-api.ts && bun run api:lint",
    "test:api": "bun test api/contract.test.ts api/route-coverage.test.ts tests/contracts scripts/api-contract src/hub/credential-api.integration.test.ts src/hub/hub.integration.test.ts src/shared/api-revisions.test.ts",
    "site:build": "astro build --root site",
    "site:check": "bun test site/site.test.ts && bun run scripts/check-api-site-links.ts site/dist",
    "api:swift": "bash scripts/verify-swift-openapi.sh"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.0.7",
    "@opencode-ai/sdk": "1.18.21",
    "@pierre/diffs": "1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "github-markdown-css": "^5.9.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.6",
    "mermaid": "^11.16.1",
    "micromark": "^4.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "shiki": "4.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.7.0",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^7.0.6",
    "bun-types": "^1.4.0",
    "fast-check": "^4.9.0",
    "linkedom": "^0.18.13",
    "mitata": "^1.0.34",
    "openapi-diff": "^0.24.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1"
  }
}
