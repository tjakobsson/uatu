{
  "name": "uatu",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "license": "MIT",
  "bin": {
    "uatu": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts serve",
    "bench:render": "bun run scripts/bench-render.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:licenses": "bun run src/shared/license-check.ts",
    "e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke-binary.ts"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.0.7",
    "@pierre/diffs": "1.3.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "github-markdown-css": "^5.9.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.6",
    "mermaid": "^11.16.0",
    "micromark": "^4.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "shiki": "4.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.7.0",
    "@playwright/test": "^1.62.1",
    "bun-types": "^1.3.14",
    "fast-check": "^4.9.0",
    "linkedom": "^0.18.13",
    "mitata": "^1.0.34",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "uuid": "^14.0.1"
  }
}
