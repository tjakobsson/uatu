---
import "../styles/global.css";
import { sitePath } from "../lib/paths";
import UatuLogo from "../components/UatuLogo.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Derive the canonical URL from the configured base instead of a hardcoded
// literal, so a base change cannot silently break canonicals.
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const canonical = new URL(Astro.url.pathname.replace(new RegExp(`^${base}/?`), `${base.replace(/^\//, "")}/`), Astro.site);
// Declared here rather than in global.css because CSS cannot interpolate the
// base path the font is served under.
const fontFace = `@font-face { font-family: "Hack Uatu"; src: url("${sitePath("fonts/HackNerdFontMono-Regular.woff2")}") format("woff2"); font-display: swap; }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <style is:inline set:html={fontFace}></style>
    <title>{title} | UatuCode</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={sitePath()} aria-label="UatuCode home">
        <UatuLogo />
        <span>UatuCode</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav" aria-label="Primary navigation">
        <a href={sitePath("docs/guides/")}>Guides</a>
        <a href={sitePath("docs/api/")}>API reference</a>
        <a class="nav-raw" href={sitePath("api/edge/openapi.yaml")}>Raw OpenAPI</a>
      </nav>
    </header>
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        const toggle = document.querySelector(".nav-toggle");
        if (!header || !toggle) return;
        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!open));
          header.classList.toggle("nav-open", !open);
        });
      })();
    </script>
    <main><slot /></main>
    <footer>
      <span>Documentation and API contracts.</span>
      <a href="https://github.com/tjakobsson/uatu">Source on GitHub</a>
    </footer>
  </body>
</html>
